// Questo blocco dice a Prisma come generare il codice per leggere i dati
generator client {
  provider = "prisma-client-js"
}

// Connessione al cloud di Neon (PostgreSQL)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// 1. IL NEGOZIO / CENTRO ESTETICO (TENANT)
// ------------------------------------------------------
model Tenant {
  id            String        @id @default(cuid()) 
  slug          String        @unique              // Es. "greenbeauty" per l'URL personalizzato
  name          String        // Nome dell'attività
  category      String?       // Categoria scelta in onboarding
  city          String?       // Citta dell'attivita
  ownerName     String?       // Nome del proprietario
  ownerEmail    String?       // Email del proprietario
  ownerPasswordHash String?    // Password proprietario salvata in modo sicuro
  logoUrl       String?       // URL immagine logo del negozio
  themeColor    String        @default("cyan") // Tema colore del negozio es. "cyan", "rose", "emerald"
  description   String?       // Descrizione pubblica generata dal template
  phone         String?       // Numero WhatsApp del salone per ricevere notifiche
  address       String?       // Indirizzo dell'attività es. "Via Roma 1, Milano"
  instagramUrl  String?       // Link profilo Instagram
  facebookUrl   String?       // Link profilo Facebook
  tiktokUrl     String?       // Link profilo TikTok
  websiteUrl    String?       // Sito esterno dell'attivita
  mapsLink      String?       // Link Google Maps
  bookingUrl    String?       // Link prenotazione esterno. Se vuoto usa WhatsApp
  openTime      String?       // Orario apertura es. "09:00"
  closeTime     String?       // Orario chiusura es. "19:00"
  breakStart    String?       // Inizio pausa pranzo es. "13:00" (null = nessuna pausa)
  breakEnd      String?       // Fine pausa pranzo es. "14:00"
  closedDays    String?       // Giorni chiusura settimanali in JSON array es. "[0,1]" (dom=0, lun=1)
  adminPassword String?       // Password autogenerata per l'accesso alla dashboard privata
  trialStartedAt DateTime?
  trialEndsAt   DateTime?     // Scadenza del periodo di prova di 7 giorni
  trialStatus   String        @default("demo") // demo, trial_active, published, expired, converted
  isDemoData    Boolean       @default(true)   // Dati generati da template, convertibili in reali
  publishedAt   DateTime?
  convertedAt   DateTime?
  plan          String        @default("basic") // "basic" o "premium"
  createdAt     DateTime      @default(now())

  // Relazioni: Tutto l'universo del salone è agganciato qui
  appointments  Appointment[]
  blockedSlots  BlockedSlot[]
  services      Service[]
  storeSettings StoreSettings?
  noShows       NoShow[]
  waitlists     Waitlist[]
  customerNotes CustomerNote[]
  activityLogs  ActivityLog[]
  staff         Staff[]
}

// ------------------------------------------------------
// 2. I SERVIZI OFFERTI (DURATE E PREZZI DINAMICI)
// ------------------------------------------------------
model Service {
  id           String        @id @default(cuid())
  name         String        // Es. "Pulizia Viso Premium", "Massaggio Relax"
  duration     Int           // Durata in minuti (Es. 30, 45, 60, 90)
  price        Float?        // Prezzo del servizio per calcolo incassi reale

  // Collegamento al Tenant
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  appointments Appointment[]

  // Membri dello staff che possono eseguire questo servizio
  staff        Staff[]
}

// ------------------------------------------------------
// 3. APPUNTAMENTI (MATRICE SAAS CORAZZATA)
// ------------------------------------------------------
model Appointment {
  id            String   @id @default(cuid()) 
  customerName  String   
  customerPhone String   // Se inserito da admin (walk-in) può essere "0000000000"
  date          String   // Giorno (es. "2026-06-22")
  
  // Logica temporale elastica
  time          String   // Ora inizio (es. "10:30")
  endTime       String?  // Ora fine computata (es. "11:30")
  
  // Armatura di Sicurezza & Controllo del Progetto 1
  cancelToken   String   @unique @default(uuid()) // Token per disdetta autonoma (limite 2h)
  source        String   @default("ONLINE")       // ONLINE o WALK_IN
  isPaid        Boolean  @default(false)          // Integrazione Stripe Mock / Salone
  createdAt     DateTime @default(now()) 

  // Relazione con il Servizio specifico
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id])

  // Relazione con lo Staff che esegue il servizio
  staffId       String?
  staff         Staff?   @relation(fields: [staffId], references: [id])

  // Relazione con il Negozio
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
}

// ------------------------------------------------------
// 4. GESTIONE CHIUSURE, PAUSE E FERIE
// ------------------------------------------------------
model BlockedSlot {
  id       String  @id @default(cuid())
  date     String  // Giorno del blocco
  time     String? // Ora inizio blocco. Se null = Giornata intera di chiusura (Ferie)
  endTime  String? // Ora fine blocco (opzionale, per pause orarie flessibili)

  // Collegamento al Tenant
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
}

// ------------------------------------------------------
// 5. IMPOSTAZIONI SALONE & PORTAFOGLIO SMS
// ------------------------------------------------------
model StoreSettings {
  id                        String   @id @default(cuid())
  smsCredits                Int      @default(0) // Crediti rimanenti Twilio per questo specifico salone
  maxConcurrentAppointments Int      @default(1) // Numero massimo di appuntamenti sovrapposti (Multi-staff)
  updatedAt                 DateTime @updatedAt

  // Relazione 1-a-1 col Tenant
  tenantId   String   @unique
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

// ------------------------------------------------------
// 6. IL REGISTRO NERO: I NO-SHOW
// ------------------------------------------------------
model NoShow {
  id            String   @id @default(cuid())
  customerPhone String   // Numero tracciato anti-furbi
  customerName  String?  
  date          String   // Giorno del "buco"
  createdAt     DateTime @default(now())

  // Collegamento al Tenant per isolamento dati
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
}

// ------------------------------------------------------
// 7. LA LISTA D'ATTESA INTELLIGENTE
// ------------------------------------------------------
model Waitlist {
  id        String   @id @default(cuid())
  name      String   
  phone     String   // Contatto WhatsApp
  date      String   // Giorno desiderato
  createdAt DateTime @default(now())

  // Collegamento al Tenant per isolamento dati
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
}

// ------------------------------------------------------
// 8. NOTE E PREFERENZE CLIENTE
// ------------------------------------------------------
model CustomerNote {
  id           String   @id @default(cuid())
  phone        String
  customerName String?
  note         String   @default("")
  preference   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, phone])
}

// ------------------------------------------------------
// 8. LOG ATTIVITA' RECENTI (ACTIVITY LOG)
// ------------------------------------------------------
model ActivityLog {
  id            String   @id @default(cuid())
  action        String   // es. "CREATE_APPOINTMENT", "DELETE_APPOINTMENT", "MOVE_APPOINTMENT", "NO_SHOW"
  actor         String   @default("system") // "client", "admin", "system"
  message       String   // Testo human-readable da mostrare nella UI
  appointmentId String?
  customerName  String?
  customerPhone String?
  date          String?
  time          String?
  metadata      String?
  createdAt     DateTime @default(now())

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ------------------------------------------------------
// 9. STAFF E SPECIALIZZAZIONI
// ------------------------------------------------------
model Staff {
  id           String        @id @default(cuid())
  name         String        // Es. "Marco", "Giulia"
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  // Servizi che questo dipendente può svolgere
  services     Service[]

  // Appuntamenti assegnati a questo dipendente
  appointments Appointment[]
}
