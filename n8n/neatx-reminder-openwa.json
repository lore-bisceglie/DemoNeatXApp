{
  "name": "NeatX — Promemoria automatici OpenWA",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "neatx-reminders",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "trigger-neatx-reminders",
      "name": "Avvia promemoria",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-760, 80],
      "webhookId": "neatx-reminders"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://neatx.store/api/reminders/queue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.NEATX_CRON_SECRET}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ date: $json.body?.date || undefined, limit: 2000 }) }}",
        "options": {}
      },
      "id": "read-reminder-queue",
      "name": "Leggi coda NeatX",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-520, 80]
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "split-reminders",
      "name": "Un promemoria alla volta",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [-280, 80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OPENWA_BASE_URL}}/api/sessions/{{$env.OPENWA_SESSION_ID}}/messages/send-text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.OPENWA_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const digits = String($json.phone || '').replace(/\\D/g, ''); const chatId = `${digits.startsWith('39') ? digits : `39${digits}`}@c.us`; return JSON.stringify({ chatId, text: $json.message }); })() }}",
        "options": {}
      },
      "id": "send-openwa",
      "name": "Invia WhatsApp con OpenWA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 80],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://neatx.store/api/reminders/delivery",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.NEATX_CRON_SECRET}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const providerMessageId = $json.messageId || $json.message_id || $json.id; const providerError = $json.error || ($json.success === false ? 'OpenWA ha rifiutato il messaggio' : ($json.status === 'error' ? ($json.message || 'OpenWA ha restituito errore') : (!providerMessageId ? 'OpenWA non ha restituito un messageId: consegna non verificabile' : ''))); const original = $('Un promemoria alla volta').item.json; return JSON.stringify({ deliveryId: original.deliveryId, leaseToken: original.leaseToken, outcome: providerError ? 'failed' : 'sent', providerMessageId, error: providerError || undefined }); })() }}",
        "options": {}
      },
      "id": "settle-delivery",
      "name": "Registra esito consegna",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 80],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $('Registra esito consegna').all();\nconst isLast = $index === items.length - 1;\nreturn isLast ? [{ json: $json }] : [];"
      },
      "id": "only-last-shot",
      "name": "Solo all'ultimo invio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://neatx.store/api/reminders/summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.NEATX_CRON_SECRET}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ date: $json.date || undefined }) }}",
        "options": {}
      },
      "id": "send-summary",
      "name": "Invia riepilogo su Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 80],
      "onError": "continueRegularOutput"
    }
  ],
